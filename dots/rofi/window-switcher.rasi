configuration {
    show-icons: true;
    display-window: "Windows";
    modi: "window";
}

* {
    font: "JetBrains Mono 13";
    background-color: #151515;
    text-color: #cccccc;
    border-color: #333333;
    selected-normal-background: rgb(0, 110, 255);
    selected-normal-foreground: #ffffff;
    normal-background: #151515;
    normal-foreground: #cccccc;
    alternate-normal-background: #151515;
    alternate-normal-foreground: #cccccc;
}

window {
    background-color: #151515;
    border: 1px;
    border-color: #333333;
    border-radius: 0;
    width: 640px;
    padding: 0;
    anchor: center;
    location: center;
}

mainbox {
    background-color: #151515;
    padding: 0;
}

listview {
    background-color: #151515;
    fixed-height: false;
    spacing: 0;
    scrollbar: false;
    padding: 4px;
}

element {
    padding: 6px 12px;
    border-radius: 0;
}

element selected {
    background-color: rgb(0, 110, 255);
}

element-icon {
    size: 24px;
    padding: 0 8px 0 0;
}

element-text {
    vertical-align: 0.5;
    padding: 0;
}

inputbar {
    background-color: #151515;
    padding: 8px 12px;
    border: 0;
}

entry {
    background-color: transparent;
    text-color: #cccccc;
}

prompt {
    background-color: transparent;
    text-color: #ffffff;
}

case-indicator {
    background-color: transparent;
    text-color: #cccccc;
}
